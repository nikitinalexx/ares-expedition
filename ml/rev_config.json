{
  "low_priority": false,
  "storage": {
    "run_root": "D:/ares/runs",
    "data_root": "D:/ares/data",
    "temp_root": "D:/ares/tmp",
    "stage_root": "C:/ares/stage",
    "reserves": [
      {
        "path": "C:/",
        "gb": 30
      },
      {
        "path": "D:/",
        "gb": 30
      }
    ],
    "data_budget_gb": 150,
    "keep_data_iterations": 1,
    "delete_data_of_other_runs": false
  },
  "java": {
    "bin": "auto",
    "xmx": "10g",
    "threads": 0
  },
  "selfplay": {
    "games_per_chunk": 1000,
    "stage_max_seconds": 5400,
    "temperature": 0,
    "max_rows_per_game_type": 8,
    "jvm_args": [
      "-Dares.agent.search=oneply",
      "-Dares.agent.search.symmetric=true",
      "-Dares.agent.search.pairs=true",
      "-Dares.agent.search.types=BUILD_CARD,DRAFT_CARDS",
      "-Dares.agent.valueModel=D:/ares/runs/value/v_rev1_margin_wide,D:/ares/runs/value/v_ens_a,D:/ares/runs/value/v_ens_b,D:/ares/runs/value/v_ens_c,D:/ares/runs/value/v_ens_d"
    ]
  },
  "eval": {
    "games": 3000,
    "references": [
      "RANDOM",
      "SMART"
    ],
    "agent": "AGENT",
    "concurrency": 32,
    "timeout_seconds": 3600,
    "bias_alarm_gap": 0.15,
    "jvm_args": [
      "-Dares.agent.search=oneply",
      "-Dares.agent.search.symmetric=true",
      "-Dares.agent.search.pairs=true",
      "-Dares.agent.search.types=BUILD_CARD,DRAFT_CARDS",
      "-Dares.agent.valueModel=D:/ares/runs/value/v_rev1_margin_wide,D:/ares/runs/value/v_ens_a,D:/ares/runs/value/v_ens_b,D:/ares/runs/value/v_ens_c,D:/ares/runs/value/v_ens_d"
    ]
  },
  "benchmark": {
    "references": [
      "NETWORK"
    ],
    "games": 100,
    "concurrency": 16,
    "timeout_seconds": 3600,
    "gate_refs": [
      "RANDOM",
      "SMART"
    ],
    "min_win_rate": 0.5,
    "jvm_args": [
      "-Dares.agent.search=oneply",
      "-Dares.agent.search.symmetric=true",
      "-Dares.agent.search.pairs=true",
      "-Dares.agent.search.types=BUILD_CARD,DRAFT_CARDS",
      "-Dares.agent.valueModel=D:/ares/runs/value/v_rev1_margin_wide,D:/ares/runs/value/v_ens_a,D:/ares/runs/value/v_ens_b,D:/ares/runs/value/v_ens_c,D:/ares/runs/value/v_ens_d"
    ]
  },
  "rungs": [
    {
      "fraction": 1.0,
      "keep": 2,
      "games_factor": 1.0
    }
  ],
  "plateau_patience": 10,
  "plateau_min_iterations": 3,
  "experiments": [
    {
      "name": "ensemble",
      "hypothesis": "The critic is the lever: 37.8% (the pipeline at the start of the session, critic trained on policy play) -> 43.59% +/- 1.0 with an ensemble of FIVE critics trained on five different exploration mixes. The steps that produced it: the critic sees the hand (20-value summary, worth ~12 points inside the critic by direct A/B), the candidate vector carries the card printed points, and the ensemble removes the ~3.5-point training variance of a single critic. Rejected on the way, with numbers in docs/RESULTS.md: V deciding act-vs-stop (0.4-0.6%), the horizon fix (19.5%), latent plans (30.8/34.95%), the build/stop dial (41.4-43.2 vs 43.6), the phase and metal plans (0.0/-0.5/-0.6 +/- 1.4-1.7), CE on exploration data (41.4 vs 42.9).",
      "games_per_iteration": 20000,
      "matchups": "AGENT:AGENT:0.85,AGENT:RANDOM:0.15",
      "max_rows_per_game_type": 8,
      "train_args": []
    }
  ],
  "train": {
    "command": [
      "{python}",
      "ml/train_policy_ppo.py",
      "--data",
      "{data}",
      "--out",
      "{model_dir}",
      "--prev",
      "{prev_model}",
      "--adv-value-model",
      "D:/ares/runs/value/v_r15_outcome",
      "--epochs",
      "3",
      "--clip",
      "0.2",
      "--entropy",
      "0.01",
      "--lr",
      "1e-4",
      "--rows-per-game",
      "8",
      "--max-chunks-per-type",
      "12"
    ],
    "timeout_seconds": 14400
  },
  "maven": {
    "command": "mvn",
    "args": [
      "-s",
      ".mvn/settings.xml"
    ]
  }
}