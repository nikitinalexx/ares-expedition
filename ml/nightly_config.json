{
  "low_priority": false,
  "storage": {
    "run_root": "D:/ares/runs",
    "data_root": "D:/ares/data",
    "temp_root": "D:/ares/tmp",
    "stage_root": "C:/ares/stage",
    "reserves": [
      {
        "path": "C:/",
        "gb": 20
      },
      {
        "path": "D:/",
        "gb": 30
      }
    ],
    "data_budget_gb": 150,
    "keep_data_iterations": 2,
    "delete_data_of_other_runs": true
  },
  "java": {
    "bin": "auto",
    "xmx": "10g",
    "threads": 0
  },
  "selfplay": {
    "games_per_chunk": 250,
    "stage_max_seconds": 3600,
    "temperature": 0.5,
    "max_rows_per_game_type": 32
  },
  "eval": {
    "games": 2000,
    "references": [
      "RANDOM",
      "SMART"
    ],
    "agent": "AGENT",
    "concurrency": 32,
    "timeout_seconds": 3600,
    "bias_alarm_gap": 0.15
  },
  "benchmark": {
    "references": [
      "NETWORK"
    ],
    "games": 100,
    "concurrency": 16,
    "timeout_seconds": 3600,
    "gate_refs": ["RANDOM", "SMART"],
    "min_win_rate": 0.5
  },
  "rungs": [
    {
      "fraction": 1.0,
      "keep": 2,
      "games_factor": 1.0
    }
  ],
  "experiments": [
    {
      "name": "control",
      "hypothesis": "N4-0: continuing from night3 best with round-robin until stop raises win rate vs RANDOM/SMART over iterations (NETWORK gated until ≥50% vs RANDOM or SMART)",
      "games_per_iteration": 7000,
      "matchups": "AGENT:AGENT:1"
    },
    {
      "name": "rows8",
      "hypothesis": "H-D3 as default: self-play writes and train keeps at most 8 rows/game/type (instead of 32) — same strength as control, less disk pressure (night3 cap8 was train-only)",
      "games_per_iteration": 7000,
      "matchups": "AGENT:AGENT:1",
      "max_rows_per_game_type": 8,
      "train_args": ["--rows-per-game", "8"]
    }
  ],
  "train": {
    "command": [
      "{python}",
      "ml/train_all.py",
      "--data",
      "{data}",
      "--out",
      "{model_dir}",
      "--prev",
      "{prev_model}",
      "--epochs",
      "50",
      "--steps",
      "100",
      "--patience",
      "5",
      "--rows-per-game",
      "32"
    ],
    "timeout_seconds": 7200
  },
  "maven": {
    "command": "mvn",
    "args": [
      "-s",
      ".mvn/settings.xml"
    ]
  }
}
