{
  "hours": 8.0,
  "low_priority": false,
  "storage": {
    "run_root": "D:/ares/runs",
    "data_root": "D:/ares/data",
    "temp_root": "D:/ares/tmp",
    "reserves": [
      {
        "path": "C:/",
        "gb": 20
      },
      {
        "path": "D:/",
        "gb": 30
      }
    ],
    "data_budget_gb": 150,
    "keep_data_iterations": 3
  },
  "java": {
    "bin": "auto",
    "xmx": "10g",
    "threads": 0
  },
  "selfplay": {
    "games_per_chunk": 500,
    "stage_max_seconds": 3600,
    "temperature": 0.5
  },
  "eval": {
    "games": 150,
    "references": [
      "SMART",
      "NETWORK"
    ],
    "agent": "AGENT",
    "concurrency": 32,
    "timeout_seconds": 3600,
    "bias_alarm_gap": 0.15
  },
  "rungs": [
    {
      "fraction": 0.3,
      "keep": 2,
      "games_factor": 0.25
    },
    {
      "fraction": 0.7,
      "keep": 1,
      "games_factor": 1.0
    }
  ],
  "experiments": [
    {
      "name": "smart_context",
      "games_per_iteration": 4000,
      "matchups": "AGENT:AGENT:1"
    },
    {
      "name": "mixed_contexts",
      "games_per_iteration": 4000,
      "matchups": "AGENT:AGENT:1,AGENT_R:AGENT_R:1,AGENT:AGENT_R:1"
    },
    {
      "name": "random_context",
      "games_per_iteration": 4000,
      "matchups": "AGENT_R:AGENT_R:1"
    }
  ],
  "train": {
    "command": [
      "{python}",
      "ml/train_all.py",
      "--data",
      "{data}",
      "--out",
      "{model_dir}",
      "--prev",
      "{prev_model}",
      "--epochs",
      "3"
    ],
    "timeout_seconds": 7200
  },
  "maven": {
    "command": "mvn",
    "args": [
      "-s",
      ".mvn/settings.xml"
    ]
  }
}
