{
  "low_priority": false,
  "storage": {
    "run_root": "D:/ares/runs",
    "data_root": "D:/ares/data",
    "temp_root": "D:/ares/tmp",
    "stage_root": "C:/ares/stage",
    "reserves": [
      {
        "path": "C:/",
        "gb": 30
      },
      {
        "path": "D:/",
        "gb": 30
      }
    ],
    "data_budget_gb": 150,
    "keep_data_iterations": 1,
    "delete_data_of_other_runs": false
  },
  "java": {
    "bin": "auto",
    "xmx": "10g",
    "threads": 0
  },
  "selfplay": {
    "games_per_chunk": 1000,
    "stage_max_seconds": 3600,
    "temperature": 0,
    "max_rows_per_game_type": 8,
    "jvm_args": [
      "-Dares.agent.search=oneply",
      "-Dares.agent.search.symmetric=true",
      "-Dares.agent.search.pairs=true",
      "-Dares.agent.search.types=BUILD_CARD,DRAFT_CARDS",
      "-Dares.agent.valueModel=D:/ares/runs/value/v_r10_outcome"
    ]
  },
  "eval": {
    "games": 3000,
    "references": [
      "RANDOM",
      "SMART"
    ],
    "agent": "AGENT",
    "concurrency": 32,
    "timeout_seconds": 3600,
    "bias_alarm_gap": 0.15,
    "jvm_args": [
      "-Dares.agent.search=oneply",
      "-Dares.agent.search.symmetric=true",
      "-Dares.agent.search.pairs=true",
      "-Dares.agent.search.types=BUILD_CARD,DRAFT_CARDS",
      "-Dares.agent.valueModel=D:/ares/runs/value/v_r10_outcome"
    ]
  },
  "benchmark": {
    "references": [
      "NETWORK"
    ],
    "games": 100,
    "concurrency": 16,
    "timeout_seconds": 3600,
    "gate_refs": [
      "RANDOM",
      "SMART"
    ],
    "min_win_rate": 0.5,
    "jvm_args": [
      "-Dares.agent.search=oneply",
      "-Dares.agent.search.symmetric=true",
      "-Dares.agent.search.pairs=true",
      "-Dares.agent.search.types=BUILD_CARD,DRAFT_CARDS",
      "-Dares.agent.valueModel=D:/ares/runs/value/v_r10_outcome"
    ]
  },
  "rungs": [
    {
      "fraction": 1.0,
      "keep": 2,
      "games_factor": 1.0
    }
  ],
  "plateau_patience": 10,
  "plateau_min_iterations": 4,
  "experiments": [
    {
      "name": "discover",
      "hypothesis": "The agent loses on the card term of the score (3.5 against 12.8 points) while it is ahead on terraforming and forests, and the encoder could not express that: the score was one number and a card candidate did not carry its own points. With the terms split (and the card's points in its features) a value function can rank a 3-point card above a 0-point one, and the search that already re-ranks builds should start converting credits into points. Training is self-play + RANDOM only (owner's rule: SMART and NETWORK are benchmarks, never opponents in training). Watch: printed card points in --mode scorecard, and whether SMART moves above 38%.",
      "games_per_iteration": 12000,
      "matchups": "AGENT:AGENT:0.75,AGENT:RANDOM:0.25",
      "max_rows_per_game_type": 8,
      "train_args": []
    }
  ],
  "train": {
    "command": [
      "{python}",
      "ml/train_policy_ppo.py",
      "--data",
      "{data}",
      "--out",
      "{model_dir}",
      "--prev",
      "{prev_model}",
      "--adv-value-model",
      "D:/ares/runs/value/v_r10_outcome",
      "--epochs",
      "3",
      "--clip",
      "0.2",
      "--entropy",
      "0.01",
      "--lr",
      "1e-4",
      "--rows-per-game",
      "8",
      "--max-chunks-per-type",
      "12"
    ],
    "timeout_seconds": 7200
  },
  "maven": {
    "command": "mvn",
    "args": [
      "-s",
      ".mvn/settings.xml"
    ]
  }
}
