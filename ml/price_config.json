{
  "low_priority": false,
  "storage": {
    "run_root": "D:/ares/runs",
    "data_root": "D:/ares/data",
    "temp_root": "D:/ares/tmp",
    "stage_root": "C:/ares/stage",
    "reserves": [
      {
        "path": "C:/",
        "gb": 30
      },
      {
        "path": "D:/",
        "gb": 30
      }
    ],
    "data_budget_gb": 150,
    "keep_data_iterations": 1,
    "delete_data_of_other_runs": false
  },
  "java": {
    "bin": "auto",
    "xmx": "10g",
    "threads": 0
  },
  "selfplay": {
    "games_per_chunk": 1000,
    "stage_max_seconds": 5400,
    "temperature": 0,
    "max_rows_per_game_type": 8,
    "jvm_args": [
      "-Dares.agent.search=oneply",
      "-Dares.agent.search.symmetric=true",
      "-Dares.agent.search.pairs=true",
      "-Dares.agent.search.types=BUILD_CARD,DRAFT_CARDS",
      "-Dares.agent.valueModel=D:/ares/runs/value/v_price1_margin_wide"
    ]
  },
  "eval": {
    "games": 3000,
    "references": [
      "RANDOM",
      "SMART"
    ],
    "agent": "AGENT",
    "concurrency": 32,
    "timeout_seconds": 3600,
    "bias_alarm_gap": 0.15,
    "jvm_args": [
      "-Dares.agent.search=oneply",
      "-Dares.agent.search.symmetric=true",
      "-Dares.agent.search.pairs=true",
      "-Dares.agent.search.types=BUILD_CARD,DRAFT_CARDS",
      "-Dares.agent.valueModel=D:/ares/runs/value/v_price1_margin_wide"
    ]
  },
  "benchmark": {
    "references": [
      "NETWORK"
    ],
    "games": 100,
    "concurrency": 16,
    "timeout_seconds": 3600,
    "gate_refs": [
      "RANDOM",
      "SMART"
    ],
    "min_win_rate": 0.5,
    "jvm_args": [
      "-Dares.agent.search=oneply",
      "-Dares.agent.search.symmetric=true",
      "-Dares.agent.search.pairs=true",
      "-Dares.agent.search.types=BUILD_CARD,DRAFT_CARDS",
      "-Dares.agent.valueModel=D:/ares/runs/value/v_price1_margin_wide"
    ]
  },
  "rungs": [
    {
      "fraction": 1.0,
      "keep": 2,
      "games_factor": 1.0
    }
  ],
  "plateau_patience": 10,
  "plateau_min_iterations": 3,
  "experiments": [
    {
      "name": "price",
      "hypothesis": "The critic is the lever: 37.8% (policy-play data) -> 38.5% (20k exploration games) -> 41.18% (100k, 512x256, 10k-game confirmation). This night continues that line from the best bundle (r23_price, 786 values including the effective-price feature) and lets PPO move the policy on data the better critic ranks. Everything else measured today was negative and is documented in docs/EXPERIMENTS.md: V as the player (0.4-0.6%), horizon stop (19.5%), latent plans (30.8/34.95%), the phase and metal chains (0.0/-0.5/-0.6 +/- 1.4-1.7).",
      "games_per_iteration": 20000,
      "matchups": "AGENT:AGENT:0.85,AGENT:RANDOM:0.15",
      "max_rows_per_game_type": 8,
      "train_args": []
    }
  ],
  "train": {
    "command": [
      "{python}",
      "ml/train_policy_ppo.py",
      "--data",
      "{data}",
      "--out",
      "{model_dir}",
      "--prev",
      "{prev_model}",
      "--adv-value-model",
      "D:/ares/runs/value/v_r15_outcome",
      "--epochs",
      "3",
      "--clip",
      "0.2",
      "--entropy",
      "0.01",
      "--lr",
      "1e-4",
      "--rows-per-game",
      "8",
      "--max-chunks-per-type",
      "12"
    ],
    "timeout_seconds": 14400
  },
  "maven": {
    "command": "mvn",
    "args": [
      "-s",
      ".mvn/settings.xml"
    ]
  }
}